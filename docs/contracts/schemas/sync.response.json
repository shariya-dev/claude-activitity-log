{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monitor.6amtech.com/contracts/sync-api-v1/sync.response.json",
  "title": "POST /sync 200 response",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean",
      "const": true
    },
    "batch_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "sync": {
      "type": "object",
      "properties": {
        "accepted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "created": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "updated": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rejected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "accepted",
        "created",
        "updated",
        "rejected"
      ]
    },
    "rejected_records": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "account",
              "project",
              "session",
              "usage",
              "message"
            ]
          },
          "source_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "source_id",
          "reason"
        ]
      }
    },
    "cursor": {
      "type": "string",
      "maxLength": 255
    },
    "settings_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "server_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "success",
    "batch_id",
    "sync",
    "rejected_records",
    "cursor",
    "settings_version",
    "server_time"
  ]
}
